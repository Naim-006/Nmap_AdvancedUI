#!/usr/bin/env python3
"""Interactive Terminal User Interface for Nmap."""

import argparse
import os
import sys

# Ensure zenmap directory is in sys.path
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
ZENMAP_DIR = os.path.join(BASE_DIR, "zenmap")
if ZENMAP_DIR not in sys.path:
    sys.path.insert(0, ZENMAP_DIR)

def main():
    parser = argparse.ArgumentParser(
        description="NMAP Toolkit - Modern Interactive Terminal User Interface (TUI)"
    )
    parser.add_argument(
        "-t", "--target",
        default="",
        help="Target IP address, hostname, CIDR, or file path"
    )
    parser.add_argument(
        "-p", "--profile",
        default=None,
        help="Initial scan profile name or number (1-9, e.g. 'Quick Scan' or '1')"
    )
    parser.add_argument(
        "--args",
        default="",
        help="Custom arguments for Custom Scan profile"
    )
    parser.add_argument(
        "--file",
        default="",
        help="Target list file for Scan from File profile"
    )
    parser.add_argument(
        "--headless",
        action="store_true",
        default=False,
        help="Run scan headlessly without opening the curses interface"
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        default=False,
        help="Disable ANSI colors in output"
    )
    processed_argv = []
    i = 1
    while i < len(sys.argv):
        if sys.argv[i] == "--args" and i + 1 < len(sys.argv):
            processed_argv.append(f"--args={sys.argv[i+1]}")
            i += 2
        else:
            processed_argv.append(sys.argv[i])
            i += 1

    args = parser.parse_args(processed_argv)
    sys.argv = [sys.argv[0]]

    if args.headless:
        from zenmapCore.tui.app import run_headless
        try:
            exit_code = run_headless(
                target=args.target,
                profile=args.profile,
                custom_args=args.args,
                target_file=args.file,
                no_color=args.no_color,
            )
            sys.exit(exit_code)
        except KeyboardInterrupt:
            sys.exit(0)

    from zenmapCore.tui.app import run_tui
    try:
        run_tui(target=args.target, profile=args.profile)
    except KeyboardInterrupt:
        sys.exit(0)

if __name__ == "__main__":
    main()
